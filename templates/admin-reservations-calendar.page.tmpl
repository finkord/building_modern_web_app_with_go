{{template "admin" .}}

{{define "page-title"}}
    Reservations Calendar
{{end}}

{{define "content"}}
    {{$now := index .Data "now"}}
    {{$rooms := index .Data "rooms"}}
    {{$dim := index .IntMap "days_in_month"}}
    {{$curMonth := index .IntMap "this_month"}}
    {{$curYear := index .IntMap "this_month_year"}}
    <div class="col-md-12">
        
        <div class="text-center">
            <h3>{{formatDate $now "January"}} {{formatDate $now "2006"}}</h3>
        </div>

        <div class="float-start">
            <a href="/admin/reservations-calendar?m={{index .StringMap "last_month"}}&y={{index .StringMap "last_month_year"}}" 
            class="btn btn-primary">
                <i class="ti-arrow-left"></i>
            </a>
        </div>

        <div class="float-end">
            <a href="/admin/reservations-calendar?m={{index .StringMap "next_month"}}&y={{index .StringMap "next_month_year"}}" 
            class="btn btn-primary">
                <i class="ti-arrow-right"></i>
            </a>
        </div>

        <div class="clearfix"></div>

        {{range $rooms}}
            {{$roomID := .ID}}

            <h5 class="mt-4">{{.RoomName}}</h5>

            <div class="table-response">
                <table class="table table-bordered table-sm">
                    <tr class="table-dark">
                        {{range $index := iterate $dim}}
                            <td clas="text-center">
                                {{add $index 1}}
                            </td>
                        {{end}}
                    </tr>

                    <tr>
                    {{range $index := iterate $dim}}
                        <td class="text-center">
                            <input type="checkbox">
                        </td>
                    {{end}}
                    </tr>
                </table>
            </div>

        {{end}}
    </div>
{{end}}
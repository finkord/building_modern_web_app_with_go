{{template "admin" .}}

{{define "page-title"}}
    Reservations Calendar
{{end}}

{{define "content"}}
    <div class="col-md-12">
        
        <div class="text-center">
            <h3>{{index .StringMap "this_month"}} - {{index .StringMap "this_month_year"}}</h3>
        </div>

        <div class="float-start">
            <a href="/admin/reservations-calendar?m={{index .StringMap "last_month"}}&y={{index .StringMap "last_month_year"}}" 
            class="btn btn-primary">
                <i class="ti-arrow-left"></i>
            </a>
        </div>

        <div class="float-end">
            <a href="/admin/reservations-calendar?m={{index .StringMap "next_month"}}&y={{index .StringMap "next_month_year"}}" 
            class="btn btn-primary">
                <i class="ti-arrow-right"></i>
            </a>
        </div>

        <div class="clearfix"></div>
    </div>
{{end}}
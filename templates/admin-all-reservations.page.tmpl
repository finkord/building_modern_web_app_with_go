{{template "admin" .}}

{{define "css"}}
    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@latest/dist/style.css" rel="stylesheet" type="text/css">
{{end}}

{{define "page-title"}}
    All Reservations
{{end}}

{{define "content"}}
    <div class="col-md-12">
        {{$reservations := .Data.reservations}}

        <table class="table table-striped" id="all-res">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Last Name</th>
                    <th>First Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Room</th>
                </tr>
            </thead>
            <tbody>
                {{range $reservations}}
                    <tr>
                        <td>{{.ID}}</td>
                        <td>
                            <a href="/admin/reservations/all/{{.ID}}">
                            {{.LastName}}
                            </a>
                        </td>
                        <td>{{.FirstName}}</td>
                        <td>{{.Email}}</td>
                        <td>{{.Phone}}</td>
                        <td>{{.StartDate | humanDate}}</td>
                        <td>{{.EndDate | humanDate}}</td>
                        <td>{{.Room.RoomName}}</td>
                    </tr>
                {{end}}
            </tbody>
        </table>
    </div>
{{end}}

{{define "js"}}
<script src="https://cdn.jsdelivr.net/npm/simple-datatables@latest" type="text/javascript"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const dataTable = new simpleDatatables.DataTable("#all-res", {
            searchable: true,
            fixedHeight: false,
            select: 5, sort: "desc",
        })
    })
</script>
{{end}}
{{template "base" .}}

{{define "content"}}
    <div class="container my-5">
        <div class="row mb-5">
            <div class="col text-center">
                <h1 class="display-4 fw-bold mb-3" style="color: #163b65;">Contact Fort Smythe</h1>
                <p class="lead text-secondary">Have questions or ready to book? We would love to hear from you.</p>
            </div>
        </div>

        <div class="row g-5">
            <!-- Left Column: Contact Details & Info -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded p-4 mb-4" style="background-color: #f8f9fa;">
                    <h4 class="fw-bold mb-4" style="color: #163b65;">Get In Touch</h4>
                    
                    <div class="d-flex align-items-start mb-3">
                        <div class="me-3 text-success">
                            <!-- SVG Icon for Map Pin -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-geo-alt-fill" viewBox="0 0 16 16">
                                <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                            </svg>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Address</h6>
                            <p class="text-muted mb-0">100 Kings Road, Clifton, New Jersey, 07011</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start mb-3">
                        <div class="me-3 text-success">
                            <!-- SVG Icon for Telephone -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-telephone-fill" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/>
                            </svg>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Phone Number</h6>
                            <p class="text-muted mb-0">(555) 555-1212</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start mb-3">
                        <div class="me-3 text-success">
                            <!-- SVG Icon for Envelope -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-envelope-fill" viewBox="0 0 16 16">
                                <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555ZM0 4.697v7.104l5.803-3.558L0 4.697ZM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-.639-.636L6.761 8.83Zm5.436-1.583L18 11.801V4.697l-5.803 3.546Z"/>
                            </svg>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Email Address</h6>
                            <p class="text-muted mb-0"><a href="mailto:info@fortsmythe.com" class="text-decoration-none text-success">info@fortsmythe.com</a></p>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded p-4" style="background-color: #f8f9fa;">
                    <h4 class="fw-bold mb-3" style="color: #163b65;">Important Info</h4>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><strong>Check-In:</strong> 3:00 PM – 9:00 PM</li>
                        <li class="mb-2"><strong>Check-Out:</strong> 11:00 AM</li>
                        <li class="mb-2"><strong>Office Hours:</strong> 8:00 AM – 10:00 PM</li>
                        <li><strong>Pet Policy:</strong> No pets allowed inside guest rooms.</li>
                    </ul>
                </div>
            </div>

            <!-- Right Column: Map Embed -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded overflow-hidden h-100">
                    <iframe 
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3019.8504781498305!2d-74.16369065!3d40.81313885!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c2f6d2f36dcd9d%3A0xe54e60155b572212!2sClifton%2C%20NJ!5e0!3m2!1sen!2sus!4v1700000000000!5m2!1sen!2sus" 
                        width="100%" 
                        height="450" 
                        style="border:0; min-height: 400px;" 
                        allowfullscreen="" 
                        loading="lazy" 
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
{{end}}

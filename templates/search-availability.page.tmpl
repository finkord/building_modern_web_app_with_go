{{template "base" .}}

{{define "content"}}
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <!-- Clean, Simple Card -->
                <div class="card border-0 shadow-sm rounded-3 p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h1 class="fw-bold h2 mb-2" style="color: #163b65;">Search for Availability</h1>
                        <p class="text-muted small">Choose your travel dates to find available quarters.</p>
                    </div>

                    <form action="/search-availability" method="post" novalidate class="needs-validation">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        
                        <div class="row" id="reservation-dates">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label for="start" class="form-label text-secondary small fw-bold">Arrival Date</label>
                                <input required class="form-control" type="text" name="start" id="start" placeholder="YYYY-MM-DD" autocomplete="off">
                            </div>
                            <div class="col-md-6">
                                <label for="end" class="form-label text-secondary small fw-bold">Departure Date</label>
                                <input required class="form-control" type="text" name="end" id="end" placeholder="YYYY-MM-DD" autocomplete="off">
                            </div>
                        </div>

                        <hr class="my-4">

                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold">Search Availability</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{{end}}

{{define "js"}}
<script>
    const elem = document.getElementById('reservation-dates');
    const rangePicker = new DateRangePicker(elem, {
        format: "yyyy-mm-dd",
        minDate: new Date(),
    });
</script>
{{end}}

